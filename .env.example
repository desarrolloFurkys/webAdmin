# Bold Colombia — https://bold.co
# Fill these in with real merchant credentials before going live.
# BOLD_API_KEY is the public "identity key" used to open Bold's hosted checkout.
# BOLD_SECRET_KEY is the private secret key used to sign the integrity hash server-side — never expose it to the client.
BOLD_API_KEY=your-bold-api-key
BOLD_SECRET_KEY=your-bold-secret-key

# Base URL used to build Bold's redirection-url (must be reachable by Bold once deployed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
